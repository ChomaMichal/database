fn create_table(name: &String, columns: &Vec<String>) -> Result<(), String> {
    if Path::new(name).exists() == true {
        return Err("Table already exists".to_string());
    }
    let mut file = match OpenOptions::new().write(true).open(name) {
        Ok(val) => val,
        Err(err) => {
            return Err(err.to_string());
        }
    };

    let buffer: [u8; PAGE] = [0; PAGE];
    file.write_all(&buffer);
    return Ok(());
}
